# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/tuvi_db"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Server Configuration
PORT=3000
NODE_ENV=development

# OAuth Configuration
OAUTH_SERVER_URL="http://localhost:3000"
OWNER_OPEN_ID="admin"
VITE_APP_ID="tuvi-ai"
VITE_OAUTH_PORTAL_URL="http://localhost:3000"

# CORS Configuration
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# LLM Configuration (Optional - can be set via admin panel)
# Option 1: OpenAI
# OPENAI_API_KEY="sk-your-openai-api-key"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o"

# Option 2: MiniMax
# OPENAI_API_KEY="your-minimax-api-key"
# OPENAI_BASE_URL="https://api.minimax.io/v1"
# OPENAI_MODEL="MiniMax-M2.5"
# Available models: MiniMax-M2.7, MiniMax-M2.7-highspeed, MiniMax-M2.5, MiniMax-M2.5-highspeed, MiniMax-M2.1, MiniMax-M2.1-highspeed, MiniMax-M2, MiniMax-M1

# Option 3: OpenRouter (uncomment to use)
# OPENAI_API_KEY="sk-or-v1-your-key"
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"
# OPENAI_MODEL="google/gemini-2.5-flash"
# Available models: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-pro, meta-llama/llama-3.1-70b

# File Storage (Optional)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=5242880

# Logging
LOG_LEVEL="info"
